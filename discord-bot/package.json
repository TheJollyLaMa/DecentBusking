{
  "name": "decentbusking-jukebox-bot",
  "version": "1.1.0",
  "description": "Discord bot: pins audio to IPFS, streams IPFS albums to voice channels (/radio), and sends private playlists (/jukebox).",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "checkpoint-mirror": "node checkpoint-mirror-client.js",
    "djuke-songs": "node djuke-songs.js",
    "mint-queue": "node mint-queue.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@livekit/rtc-node": "1.2.1",
    "acorn": "^8.19.0",
    "cheerio": "^1.2.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.17.0",
    "ffmpeg-static": "^5.3.0",
    "ipfs-unixfs-importer": "^17.1.1",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "multiformats": "^13.4.2",
    "opusscript": "^0.0.8",
    "tweetnacl": "^1.0.3"
  }
}
