# DecentBusking Jukebox Bot — environment variables
# Copy this file to .env and fill in the values before running the bot.

# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token-here

# Numeric ID of the #jukebox channel the bot should watch for audio uploads.
# Enable Developer Mode in Discord (Settings → Advanced → Developer Mode),
# then right-click the channel and choose "Copy Channel ID".
JUKEBOX_CHANNEL_ID=123456789012345678

# ── IPFS uploads ──────────────────────────────────────────────────────────────
# Production: Pinata credentials remain server-side on Render.
IPFS_UPLOAD_PROVIDER=pinata
PINATA_JWT=your-pinata-jwt
PINATA_API_URL=https://uploads.pinata.cloud/v3/files
PINATA_SIGN_URL=https://uploads.pinata.cloud/v3/files/sign
PINATA_FILES_API_URL=https://api.pinata.cloud/v3/files

# Public Render URL used only in private owner approval links.
PUBLIC_WORKER_URL=https://your-decentbusking-service.onrender.com

# GitHub Pages, custom-domain, and local origins allowed to request an owner-signed upload URL.
IPFS_ALLOWED_ORIGINS=https://thejollylama.github.io,https://decentbusking.com,https://www.decentbusking.com,http://localhost:4173,http://127.0.0.1:4173

# Base wallet holding DEFAULT_ADMIN_ROLE on the DecentNFT contract.
MINT_OWNER_WALLET=0x0000000000000000000000000000000000000000

# LOCAL MACHINE ONLY — used by `npm run mint-queue`. Never set this on Render.
# MINT_OWNER_PRIVATE_KEY=

# Local alternative: set IPFS_UPLOAD_PROVIDER=local and run Kubo/IPFS Desktop.
IPFS_API_URL=http://127.0.0.1:5001

# Optional local-first playlist checkpoints. Set the SAME dedicated random secret
# privately on Render and the Mac mirror client; never use a wallet key or JWT.
# When enabled, an offline mirror blocks new Pinata playlist checkpoints.
# CHECKPOINT_MIRROR_SECRET=
# Enable only after code deployment and a connected local mirror client.
DBUSK_IMPORT_REVIEWED_ALBUMS=false

# DJuke paid queue. Set the address after deploying DecentJukeBox_v0_1.
# The fulfiller key belongs to a dedicated low-balance wallet holding only FULFILLER_ROLE.
# DJUKE_CONTRACT_ADDRESS=
# DJUKE_FULFILLER_PRIVATE_KEY=
DJUKE_PAYMENTS_ENABLED=false

# DeVert main-radio scheduler. Keep contract unset until staging playback passes.
DEVERT_CONTRACT_ADDRESS=
# Optional override; defaults to the existing DJUKE_FULFILLER_PRIVATE_KEY.
DEVERT_SCHEDULER_PRIVATE_KEY=
DEVERT_CONFIRMATIONS=2
# Independent paid advert FIFO. Leave unset/disabled until its separate contract is deployed.
# Reuses the scheduler wallet; requires its fulfiller role, Pinata and the checkpoint mirror.
DEVERT_QUEUE_CONTRACT_ADDRESS=
# Legacy v0.1 = 1 (read-only checkout); replacement v0.2 = 2 (two priority tiers).
DEVERT_QUEUE_VERSION=1
DEVERT_QUEUE_PAYMENTS_ENABLED=false
# AdLoop uses a second Discord bot; one bot cannot join two voice channels in one guild.
# Create a voice channel named VertLoop and a text channel named vertloop; configure their IDs below.
# DVERT_LOOP_DISCORD_TOKEN=
# Enable only after turning on Message Content intent for DVertLoop in Discord.
DVERT_LOOP_AD_INTAKE_ENABLED=false
# VERT_LOOP_CHANNEL_ID=  # ID of the #vertloop text channel
# VERTLOOP_VOICE_CHANNEL_ID=  # ID of the VertLoop voice channel

# Comma-separated older DecentNFT addresses kept in duplicate checks after a contract switch.
# DECENT_NFT_ADDITIONAL_ADDRESSES=

# ── DecentBusking site ────────────────────────────────────────────────────────
# The bot appends ?title=<track>&ipfs=<CID> to this URL when building the mint link.
# Default: https://thejollylama.github.io/DecentBusking
SITE_URL=https://thejollylama.github.io/DecentBusking

# ── IPFS gateway ─────────────────────────────────────────────────────────────
# HTTP gateway used to list directory contents and stream tracks for /radio and /jukebox.
# Default: https://dweb.link
# Other options: https://ipfs.io
IPFS_GATEWAY=https://dweb.link

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Path to the ffmpeg binary used for audio transcoding in /radio mode and JukeLoop.
# If ffmpeg is on your system PATH you can leave this unset.
# Example: FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFMPEG_PATH=ffmpeg

# ── JukeLoop ──────────────────────────────────────────────────────────────────
# JukeLoop provides a 24/7 website radio broadcast with optional Discord voice.
# It aggregates all audio files posted in #DecentJukebox (JUKEBOX_CHANNEL_ID above)
# and plays them on a rolling, rating-weighted playlist.
#
# The text channel ID enables JukeLoop; the voice channel ID is optional.
# To find channel IDs: enable Discord Developer Mode (Settings → Advanced),
# then right-click the channel and choose "Copy Channel ID".

# Numeric ID of the JukeLoop VOICE channel (where audio is streamed).
JUKE_LOOP_VOICE_CHANNEL_ID=123456789012345679

# Numeric ID of the JukeLoop TEXT channel (where "Now Playing" announcements go).
JUKE_LOOP_TEXT_CHANNEL_ID=123456789012345680

# Manual owner-confirmed calendar promotion (independent of playback/payroll channels)
ANNOUNCE_CHANNEL_ID=943117480883265539
# everyone (default), none, or comma-separated mentionable guild role IDs (e.g. JukeboxHero's ID)
ANNOUNCE_DEFAULT_MENTION=everyone

# Disable only the Discord voice output; keep website radio and text announcements.
JUKE_LOOP_VOICE_ENABLED=true

# Optional operator override for a known Discord cooldown (UTC ISO timestamp).
# New gateway/global 429 deadlines are checkpointed automatically.
# DISCORD_LOGIN_NOT_BEFORE=2026-10-20T14:31:05Z

# Set to true to disable the IPFS pinning and "Mint as DNFT" embed when audio
# files are posted. Useful when running JukeLoop as a standalone radio bot.
# Default: false (mint flow is active)
DISABLE_MINT_FLOW=false

# ── RPC endpoints (keep keys here / in Render only, never in decent.config.js) ──
# Tiered routing (#205): reads go public-first, history scans and our own transactions go paid-first.
# Any non-public URL below is treated as the paid tier. Health: GET /api/rpc-health (no keys shown).
# Browsers read Base from free public RPCs first and only fall back to POST /api/rpc, a read-only proxy
# (allow-listed methods and DecentBusking contracts, 120 calls/min per IP, 1500/min total) that rides this router.
# ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# BASE_PUBLIC_RPC_URLS=https://base-rpc.publicnode.com,https://base.gateway.tenderly.co,https://mainnet.base.org
# Monthly Alchemy budget pacing. Spend is paced evenly across the month (persisted to Pinata across restarts):
#   normal        -> on pace: reads public-first, history scans + transactions paid-first
#   conserve      -> ahead of pace: only transactions stay paid-first; background polling slows to every 3 min
#   critical-only -> spendable budget used (reserve kept): paid tier only for transactions; polling every 5 min
#   exhausted     -> Alchemy refused (spending cap hit): public only, paid re-probed every 30 min for transactions
# ~60M CU leaves headroom under a $33 Pay As You Go cap (CU estimates are approximate).
# ALCHEMY_MONTHLY_CU_BUDGET=60000000
# Fraction of the monthly budget held back for transaction paths (default 0.1).
# ALCHEMY_CU_RESERVE_FRACTION=0.1
# Optional: also go into conserve mode once a single day passes this many CU.
# ALCHEMY_DAILY_CU_SOFT_LIMIT=
# PAYROLL_ARCHIVE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# BASE_LOGS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# Mainnet ENS lookups served to the browser via /api/ens/*; falls back to ENS_RPC_URL, then publicnode.
# ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
# ENS_RPC_URL=https://ethereum-rpc.publicnode.com
# Alchemy custom webhook (Base Mainnet) pointed at https://<worker>/api/webhooks/alchemy. Verified deliveries
# trigger an immediate refresh of the matching ledgers; while set, chain pollers relax to WEBHOOK_SAFETY_POLL_MS.
# ALCHEMY_WEBHOOK_SIGNING_KEY=whsec_...
# WEBHOOK_SAFETY_POLL_MS=300000
