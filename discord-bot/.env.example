# DecentBusking Jukebox Bot — environment variables
# Copy this file to .env and fill in the values before running the bot.

# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token-here

# Numeric ID of the #jukebox channel the bot should watch for audio uploads.
# Enable Developer Mode in Discord (Settings → Advanced → Developer Mode),
# then right-click the channel and choose "Copy Channel ID".
JUKEBOX_CHANNEL_ID=123456789012345678

# ── IPFS uploads ──────────────────────────────────────────────────────────────
# Production: Pinata credentials remain server-side on Render.
IPFS_UPLOAD_PROVIDER=pinata
PINATA_JWT=your-pinata-jwt
PINATA_API_URL=https://uploads.pinata.cloud/v3/files
PINATA_SIGN_URL=https://uploads.pinata.cloud/v3/files/sign
PINATA_FILES_API_URL=https://api.pinata.cloud/v3/files/public

# Public Render URL used only in private owner approval links.
PUBLIC_WORKER_URL=https://your-decentbusking-service.onrender.com

# GitHub Pages and local origins allowed to request an owner-signed upload URL.
IPFS_ALLOWED_ORIGINS=https://thejollylama.github.io,http://localhost:4173

# Base wallet holding DEFAULT_ADMIN_ROLE on the DecentNFT contract.
MINT_OWNER_WALLET=0x0000000000000000000000000000000000000000

# Local alternative: set IPFS_UPLOAD_PROVIDER=local and run Kubo/IPFS Desktop.
IPFS_API_URL=http://127.0.0.1:5001

# ── DecentBusking site ────────────────────────────────────────────────────────
# The bot appends ?title=<track>&ipfs=<CID> to this URL when building the mint link.
# Default: https://thejollylama.github.io/DecentBusking
SITE_URL=https://thejollylama.github.io/DecentBusking

# ── IPFS gateway ─────────────────────────────────────────────────────────────
# HTTP gateway used to list directory contents and stream tracks for /radio and /jukebox.
# Default: https://dweb.link
# Other options: https://ipfs.io
IPFS_GATEWAY=https://dweb.link

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Path to the ffmpeg binary used for audio transcoding in /radio mode and JukeLoop.
# If ffmpeg is on your system PATH you can leave this unset.
# Example: FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFMPEG_PATH=ffmpeg

# ── JukeLoop ──────────────────────────────────────────────────────────────────
# JukeLoop provides a 24/7 community radio stream in the JukeLoop voice channel.
# It aggregates all audio files posted in #DecentJukebox (JUKEBOX_CHANNEL_ID above)
# and plays them on a rolling, rating-weighted playlist.
#
# Both IDs are OPTIONAL — omit them (or leave them blank) to disable JukeLoop.
# To find channel IDs: enable Discord Developer Mode (Settings → Advanced),
# then right-click the channel and choose "Copy Channel ID".

# Numeric ID of the JukeLoop VOICE channel (where audio is streamed).
JUKE_LOOP_VOICE_CHANNEL_ID=123456789012345679

# Numeric ID of the JukeLoop TEXT channel (where "Now Playing" announcements go).
JUKE_LOOP_TEXT_CHANNEL_ID=123456789012345680

# Set to true to disable the IPFS pinning and "Mint as DNFT" embed when audio
# files are posted. Useful when running JukeLoop as a standalone radio bot.
# Default: false (mint flow is active)
DISABLE_MINT_FLOW=false
